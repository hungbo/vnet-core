# Copy to .env next to docker-compose.yml and fill in before the first start.
#   cp .env.docker.example .env
#
# Compose refuses to start if DB_PASSWORD, JWT_SECRET or ALLOWED_ORIGINS is
# missing, and the server itself refuses to start in release mode on unsafe
# values. That is deliberate: the defaults are development conveniences and are
# not safe to run a business on.

# ----------------------------------------------------------------- database
DB_USER=vnet
DB_NAME=vnet

# Required. No default is provided on purpose.
DB_PASSWORD=

# ------------------------------------------------------------------ security
# Required, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Changing it later invalidates every issued token and logs everyone out.
JWT_SECRET=

# Required. Comma-separated, no wildcard — "*" is rejected in release mode.
# The admin is served from the same origin as the API, so list only the public
# address plus any other client that calls the API directly.
#   ALLOWED_ORIGINS=https://vnet.example.com
ALLOWED_ORIGINS=

# Access token lifetime, and how long a refresh token stays valid.
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# ------------------------------------------------------------------- runtime
# Host port for the admin UI and the API.
APP_PORT=8080

# Tags the built image and is reported by the binary.
VERSION=latest

# Số ngày giữ lại lịch sử phần cứng (nhiệt độ, %CPU/RAM/ổ đĩa, thời gian bật).
# Mỗi máy ghi một dòng cho mỗi lần báo cáo, tức khoảng 5.800 dòng mỗi ngày cho
# mỗi máy — một quán 50 máy sinh gần 290 nghìn dòng/ngày. Máy chủ tự xoá phần
# quá hạn, mỗi giờ một lượt và một lượt ngay khi khởi động.
# Đặt 0 nếu muốn giữ lại tất cả và tự dọn bằng tay.
HARDWARE_HISTORY_DAYS=7

# ------------------------------------------------------------ máy trạm
# Máy trạm KHÔNG cấu hình ở đây. Mỗi máy có khoá riêng, cấp ở trang Máy trên
# giao diện quản trị (nút "Cấp khoá"), rồi ghi vào cấu hình của chính máy đó:
#
#   VNET_SERVER_URL=http://<địa chỉ máy chủ>:8080
#   VNET_MACHINE_CODE=PC-01
#   VNET_AGENT_TOKEN=<khoá cấp cho PC-01>
#
# Thiếu khoá thì máy chủ từ chối heartbeat (401) và máy hiện là ngoại tuyến.
